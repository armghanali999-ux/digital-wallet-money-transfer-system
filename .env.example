# Copy to .env and replace every placeholder locally. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
DJANGO_TIME_ZONE=Asia/Karachi
DJANGO_LOG_LEVEL=INFO
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false

MYSQL_DATABASE=digital_wallet
MYSQL_TEST_DATABASE=test_digital_wallet
MYSQL_USER=digital_wallet_app
MYSQL_PASSWORD=replace-with-a-strong-local-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Railway: use the private MySQL connection URL supplied by a linked MySQL service.
# Do not commit its real value.
DATABASE_URL=mysql://user:password@host:3306/database
PORT=8000
